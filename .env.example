# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead.

# Sarvam AI — Speech-to-Text (saarika) & Text-to-Speech (bulbul)
SARVAM_API_KEY=

# Google Gemini — question engine, extraction, OCR parsing, summary generation
GEMINI_API_KEY=

# Mistral — OCR for uploaded prescriptions/reports
MISTRAL_API_KEY=

# Supabase — session/clinical data persistence (used by /api/session)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
